{
  "version": 1,
  "hooks": {
    "afterFileEdit": [
      {
        "command": "python3 .agents/scripts/ai_code_review.py --runtime cursor track",
        "timeout": 10
      }
    ],
    "stop": [
      {
        "command": "python3 .agents/scripts/ai_code_review.py --runtime cursor review",
        "timeout": 180,
        "loop_limit": 5
      }
    ]
  }
}
